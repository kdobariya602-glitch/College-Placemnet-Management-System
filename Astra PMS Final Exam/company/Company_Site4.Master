    <script src="../assets/vendor/bootstrap/bootstrap.bundle.min.js"></script>

    <script src="../assets/vendor/chartjs/chart.umd.min.js"></script>

    <script src="../assets/js/app.js"></script>

    <script type="text/javascript">
        function toggleAstraAiDrawer() {
            var myOffcanvas = new bootstrap.Offcanvas(document.getElementById('offcanvasAstraAi'));
            document.getElementById('aiActivePageTitle').innerText = document.title || 'Astra PMS Portal';
            myOffcanvas.show();
        }

        function summarizeCurrentPage() {
            var box = document.getElementById('aiDrawerChatBox');
            var title = document.title || 'Placement Module';
            box.innerHTML = '<div class="text-primary small fw-bold mb-1"><i class="bi bi-cpu me-1"></i> Page Intelligence Scan:</div>' +
                            '<div class="text-dark small"><strong>Active View:</strong> ' + title + '</div>' +
                            '<div class="small text-muted mt-2">• Multi-factor data ledger is active and synced with Astra database.<br/>• All action buttons offer Dual-Mode (Manual OR AI-assisted).<br/>• Verified zero integrity errors on page data controls.</div>';
        }

        function recommendNextAction() {
            var box = document.getElementById('aiDrawerChatBox');
            box.innerHTML = '<div class="text-success small fw-bold mb-1"><i class="bi bi-check-circle me-1"></i> AI Recommended Next Step:</div>' +
                            '<div class="small text-dark mt-1">Review recently published circulars and verify active deadlines in the portal. Ensure all required document records are confirmed.</div>';
        }

        function askAstraAi(prompt) {
            document.getElementById('aiDrawerInput').value = prompt;
            sendAstraAiMessage();
        }

        function sendAstraAiMessage() {
            var input = document.getElementById('aiDrawerInput');
            var q = input.value.trim();
            if (!q) return;
            var box = document.getElementById('aiDrawerChatBox');
            
            var userHtml = '<div class="p-2 mb-2 rounded bg-light text-dark fw-semibold small text-end"><i class="bi bi-person me-1"></i>' + q + '</div>';
            box.innerHTML += userHtml;
            input.value = '';
            box.scrollTop = box.scrollHeight;

            setTimeout(function() {
                var answer = "Astra AI: I have processed your inquiry regarding '" + q + "'. All guidelines and automated templates are synchronized with the placement cell policies. Please check the respective module action buttons for 1-click execution.";
                if (q.toLowerCase().indexOf('offer') !== -1) {
                    answer = "Astra AI: For campus offers, ensure compliance with the One-Student-One-Offer rule. Offers above 10 LPA qualify as Dream Category.";
                } else if (q.toLowerCase().indexOf('drive') !== -1 || q.toLowerCase().indexOf('job') !== -1) {
                    answer = "Astra AI: Active recruitment drives require verified CGPA and zero active backlogs. Check the 'Drives' tab for round details and dates.";
                }
                var aiHtml = '<div class="p-2 mb-2 rounded bg-primary bg-opacity-10 border border-primary border-opacity-25 text-dark small"><i class="bi bi-stars text-primary me-1"></i>' + answer + '</div>';
                box.innerHTML += aiHtml;
                box.scrollTop = box.scrollHeight;
            }, 500);
        }
    </script>
    

</body>

