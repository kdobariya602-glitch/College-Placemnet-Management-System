                <section class="ap-hero has-photo">
                    <div class="ap-hero-bg" style="background-image: url('assets/images/home1.jpg');"></div>
                    <div class="ap-grid-dots"></div>
                    <svg class="ap-route" viewBox="0 0 1200 500" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M-20 380 C 220 380, 220 200, 420 200 S 620 60, 820 60 S 1020 220, 1240 180" stroke="#38bdf8" stroke-width="2" fill="none" stroke-dasharray="2 10" stroke-linecap="round" opacity=".6" />
