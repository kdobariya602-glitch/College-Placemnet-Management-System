                            <img src="assets/images/Companies/wipro.jpg" alt="Wipro logo" loading="lazy" style="height: 26px; opacity: 1;">
                            <img src="assets/images/Companies/cisco.jpg" alt="Cisco logo" loading="lazy" style="height: 26px; opacity: 1;">
                        </div>
                    </div>
                </section>

                <div class="ap-stats-band">
                    <div class="container">
                        <div class="row g-0">
                            <div class="col-6 col-md-4 col-lg-2 ap-stat">
                                <div class="num" data-count="4820">0</div>
                                <div class="label">Students Placed</div>
                            </div>
                            <div class="col-6 col-md-4 col-lg-2 ap-stat">
                                <div class="num" data-count="260">0</div>
                                <div class="label">Companies Visited</div>
                            </div>
                            <div class="col-6 col-md-4 col-lg-2 ap-stat">
                                <div class="num" data-count="5340">0</div>
                                <div class="label">Placement Offers</div>
                            </div>
                            <div class="col-6 col-md-4 col-lg-2 ap-stat">
                                <div class="num" data-count="42" data-suffix=" LPA">0</div>
                                <div class="label">Highest Package</div>
                            </div>
                            <div class="col-6 col-md-4 col-lg-2 ap-stat">
                                <div class="num" data-count="7.8" data-decimals="1" data-suffix=" LPA">0</div>
