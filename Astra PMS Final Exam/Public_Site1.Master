                        <circle cx="820" cy="60" r="5" fill="#f5a524" />
                        <circle cx="1240" cy="180" r="5" fill="#38bdf8" />
                    </svg>
                    <div class="container ap-hero-inner">
                        <div class="row align-items-center g-5">
                            <div class="col-lg-9 ap-reveal">
                                <span class="ap-hero-badge"><i class="bi bi-broadcast"></i>2026&ndash;27 Placement Season is Live</span>
                                <h1 class="mt-3 mb-3">Empowering Careers Through Excellence in Placements</h1>
                                <p class="lead">Astra University's Training &amp; Placement Cell bridges classroom learning and industry careers &mdash; through structured training, verified employability, and partnerships with over 250 recruiting organisations.</p>
                                <div class="d-flex flex-wrap gap-3 mt-4">
                                    <a href="placement-events.aspx" class="ap-btn ap-btn-primary">View Placement Drives <i class="bi bi-arrow-right"></i></a>
                                    <a href="our-recruiters.aspx" class="ap-btn ap-btn-ghost">Our Recruiters</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="ap-trusted-strip" style="padding: 1.75rem 0; background: #fff; border-bottom: 1px solid var(--ap-line); overflow: hidden;">
                    <div class="container">
                        <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 gap-lg-5">
                            <span style="font-size: .78rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ap-text-soft); white-space: nowrap;">Trusted by</span>
                            <img src="assets/images/Companies/microsoft.jpg" alt="Microsoft logo" loading="lazy" style="height: 26px; opacity: 1;">
                            <img src="assets/images/Companies/Google.jpg" alt="Google logo" loading="lazy" style="height: 26px; opacity: 1;">
                            <img src="assets/images/Companies/amazon.jpg" alt="Amazon logo" loading="lazy" style="height: 26px; opacity: 1;">
