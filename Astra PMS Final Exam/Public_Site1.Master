                            <img src="assets/images/Companies/capgemini.jpg" alt="Capgemini logo" loading="lazy" style="height: 26px; opacity: 1;">
                            <img src="assets/images/Companies/salesforce.jpg" alt="Salesforce logo" loading="lazy" style="height: 26px; opacity: 1;">
