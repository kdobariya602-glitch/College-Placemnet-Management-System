                <section class="ap-section">
                    <div class="container">
                        <div class="text-center mx-auto mb-5 ap-reveal" style="max-width: 640px;">
                            <span class="ap-eyebrow">Why Astra</span>
                            <h2 class="mt-3 mb-2">Why Choose Astra Placement Cell</h2>
                            <p class="ap-kicker mx-auto">A complete employability pipeline &mdash; not just a placement office.</p>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-6 col-lg-3 ap-reveal">
                                <div class="ap-card ap-feature">
                                    <div class="ap-card-body">
                                        <div class="ap-icon-tile"><i class="bi bi-briefcase"></i></div>
                                        <h5>Industry Collaboration</h5>
                                        <p>MoUs with 250+ organisations for internships, live projects and campus drives.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3 ap-reveal">
                                <div class="ap-card ap-feature">
                                    <div class="ap-card-body">
                                        <div class="ap-icon-tile"><i class="bi bi-mortarboard"></i></div>
                                        <h5>Placement Training</h5>
                                        <p>Structured 6-month readiness programme across aptitude, coding and communication.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3 ap-reveal">
                                <div class="ap-card ap-feature">
                                    <div class="ap-card-body">
                                        <div class="ap-icon-tile"><i class="bi bi-signpost-2"></i></div>
                                        <h5>Career Guidance</h5>
                                        <p>One-on-one counselling to help students map roles to their strengths.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3 ap-reveal">
                                <div class="ap-card ap-feature">
                                    <div class="ap-card-body">
                                        <div class="ap-icon-tile"><i class="bi bi-camera-video"></i></div>
                                        <h5>Mock Interviews</h5>
                                        <p>Recorded mock rounds with feedback from alumni and HR practitioners.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3 ap-reveal">
                                <div class="ap-card ap-feature">
                                    <div class="ap-card-body">
                                        <div class="ap-icon-tile"><i class="bi bi-file-earmark-person"></i></div>
                                        <h5>Resume Building</h5>
                                        <p>Role-specific resume clinics reviewed by the corporate relations team.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3 ap-reveal">
                                <div class="ap-card ap-feature">
                                    <div class="ap-card-body">
                                        <div class="ap-icon-tile"><i class="bi bi-people"></i></div>
                                        <h5>Soft Skills</h5>
                                        <p>Group discussions, communication labs and personality development workshops.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3 ap-reveal">
                                <div class="ap-card ap-feature">
                                    <div class="ap-card-body">
                                        <div class="ap-icon-tile"><i class="bi bi-cpu"></i></div>
                                        <h5>Technical Assessments</h5>
                                        <p>Domain-wise practice tests aligned to recruiter evaluation patterns.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3 ap-reveal">
                                <div class="ap-card ap-feature">
                                    <div class="ap-card-body">
                                        <div class="ap-icon-tile"><i class="bi bi-laptop"></i></div>
                                        <h5>Internship Opportunities</h5>
                                        <p>Pre-placement internships that convert into confirmed full-time offers.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>


                <section class="ap-section" style="background: var(--ap-surface-alt);">
                    <div class="container">
                        <div class="text-center mx-auto mb-5 ap-reveal" style="max-width: 640px;">
                            <span class="ap-eyebrow">The Journey</span>
                            <h2 class="mt-3 mb-2">Placement Process</h2>
                            <p class="ap-kicker mx-auto">Eight checkpoints from registration to your offer letter.</p>
                        </div>
                        <div class="row g-4 ap-route-line">
                            <div class="col-6 col-md-3 ap-route-stop ap-reveal">
                                <div class="ap-route-dot">01</div>
                                <h6>Student Registration</h6>
                                <p>Register on the TPC portal with academic and personal details.</p>
                            </div>
                            <div class="col-6 col-md-3 ap-route-stop ap-reveal">
                                <div class="ap-route-dot">02</div>
                                <h6>Resume Verification</h6>
                                <p>Coordinators verify and approve your resume before drives.</p>
                            </div>
                            <div class="col-6 col-md-3 ap-route-stop ap-reveal">
                                <div class="ap-route-dot">03</div>
                                <h6>Training Sessions</h6>
                                <p>Attend mandatory aptitude, coding and soft-skill training.</p>
                            </div>
                            <div class="col-6 col-md-3 ap-route-stop ap-reveal">
                                <div class="ap-route-dot">04</div>
                                <h6>Aptitude Test</h6>
                                <p>Clear the recruiter's shortlisting aptitude round.</p>
                            </div>
                            <div class="col-6 col-md-3 ap-route-stop ap-reveal">
                                <div class="ap-route-dot">05</div>
                                <h6>Technical Interview</h6>
                                <p>Domain interview with the recruiting panel.</p>
                            </div>
                            <div class="col-6 col-md-3 ap-route-stop ap-reveal">
                                <div class="ap-route-dot">06</div>
                                <h6>HR Interview</h6>
                                <p>Final round assessing fit, communication and intent.</p>
                            </div>
                            <div class="col-6 col-md-3 ap-route-stop ap-reveal">
                                <div class="ap-route-dot">07</div>
                                <h6>Offer Letter</h6>
                                <p>Receive and review the official offer letter.</p>
                            </div>
                            <div class="col-6 col-md-3 ap-route-stop ap-reveal">
                                <div class="ap-route-dot">08</div>
                                <h6>Successful Placement</h6>
                                <p>Confirm acceptance and begin onboarding formalities.</p>
                            </div>
                        </div>
                    </div>
                </section>


                <section class="ap-section">
                    <div class="container">
                        <div class="text-center mx-auto mb-5 ap-reveal" style="max-width: 640px;">
                            <span class="ap-eyebrow">Alumni Voices</span>
                            <h2 class="mt-3 mb-2">Success Stories</h2>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-4 ap-reveal">
