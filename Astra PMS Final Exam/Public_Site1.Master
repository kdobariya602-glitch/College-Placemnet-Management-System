                <section class="ap-section" style="background: var(--ap-surface-alt);">
                    <div class="container" style="max-width: 820px;">
                        <div class="text-center mb-5 ap-reveal">
                            <span class="ap-eyebrow">Support</span>
                            <h2 class="mt-3 mb-0">Frequently Asked Questions</h2>
                        </div>
                        <div class="accordion ap-accordion ap-reveal" id="homeFaq">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq0">Who is eligible for on-campus placements?</button>
                                </h2>
                                <div id="faq0" class="accordion-collapse collapse" data-bs-parent="#homeFaq">
                                    <div class="accordion-body">Students with no active academic backlogs and meeting the minimum CGPA specified in the Placement Policy for their programme.</div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">Can I sit for a company after accepting another offer?</button>
                                </h2>
                                <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#homeFaq">
                                    <div class="accordion-body">No. Once an offer is accepted through the TPC portal, the Offer Acceptance Policy restricts further participation, except for pre-approved dream companies.</div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">How do I register for a placement drive?</button>
                                </h2>
                                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#homeFaq">
                                    <div class="accordion-body">Log in to the Student Panel, complete your profile, and click Apply on the specific drive under Upcoming Drives.</div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">Are internships counted separately from placements?</button>
                                </h2>
                                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#homeFaq">
                                    <div class="accordion-body">Yes. Internship offers are tracked independently, though many convert into full-time offers after evaluation.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

